# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.
# You (the user) select all model versions; the app reads them here at runtime, no hardcoding.

# --- LLM backend ---------------------------------------------------------
# Provider: "openrouter" | "anthropic" | "stub" (stub = deterministic, no network, no key needed)
ADMISSION_ENGINE_LLM_PROVIDER=stub

# OpenRouter (https://openrouter.ai) — set the exact model id you want this week.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic (Claude) — set the exact model id.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional request tuning
ADMISSION_ENGINE_LLM_TIMEOUT_SECONDS=60
ADMISSION_ENGINE_LLM_MAX_TOKENS=2000

# --- PHI gate ------------------------------------------------------------
# A CLOUD LLM (openrouter/anthropic) may only be sent RAW PHI inside the approved §8 environment.
# Leave UNSET for synthetic/redacted-only use (the default, safe posture).
# Set to 1 ONLY inside the approved environment (see prereg/REAL_DATA_READINESS.md).
# ADMISSION_ENGINE_PHI_ENV_APPROVED=1

# --- App -----------------------------------------------------------------
ADMISSION_ENGINE_APP_HOST=127.0.0.1
ADMISSION_ENGINE_APP_PORT=8000
